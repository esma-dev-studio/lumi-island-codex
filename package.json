{
  "name": "lumi-island",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/clean_dist.mjs && vinext build",
    "start": "vinext start",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern playwright-report --ignore-pattern test-results --ignore-pattern artifacts",
    "typecheck": "tsc --noEmit",
    "test:logic": "vitest run --config vitest.config.ts tests/gameLogic.test.ts",
    "report:phase2.3": "node scripts/generate_phase2_3_metrics.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.18.1",
    "@babylonjs/loaders": "^9.18.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "gltf-validator": "^2.0.0-dev.3.10",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "type": "module",
  "description": "An original 3D slow-life browser game about gathering light and building a tiny island home.",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "minimatch": "10.2.6"
  }
}
